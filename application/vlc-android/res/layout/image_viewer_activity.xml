<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black">

        <org.videolan.vlc.gui.image.FreePagerView
                android:id="@+id/free_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        <org.videolan.vlc.gui.image.CardStackPager
                android:id="@+id/card_stack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/strip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        <LinearLayout
                android:id="@+id/scrubber_bar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/image_viewer_scrubber_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:visibility="gone">

            <TextView
                    android:id="@+id/pill_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:minWidth="72dp"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

            <SeekBar
                    android:id="@+id/page_scrubber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/page_scrubber_cd" />

            <ImageView
                    android:id="@+id/auto_scroll_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/auto_scroll"
                    android:padding="10dp"
                    android:src="@drawable/ic_auto_scroll"
                    app:tint="@color/white" />

        </LinearLayout>

        <LinearLayout
                android:id="@+id/overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="#66000000"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="36dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

            <ImageView
                    android:id="@+id/back_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:contentDescription="@string/image_browser"
                    android:src="@drawable/ic_close_up"
                    app:tint="@color/white" />

            <TextView
                    android:id="@+id/image_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

            <TextView
                    android:id="@+id/image_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

            <ImageView
                    android:id="@+id/mode_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:contentDescription="@string/viewer_mode"
                    android:src="@drawable/ic_viewer_mode"
                    app:tint="@color/white" />

            <ImageView
                    android:id="@+id/slideshow_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:contentDescription="@string/image_slideshow"
                    android:src="@drawable/ic_slideshow_play"
                    app:tint="@color/white" />

            <ImageView
                    android:id="@+id/share_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:contentDescription="@string/image_share"
                    android:src="@drawable/ic_share"
                    app:tint="@color/white" />

        </LinearLayout>

    </FrameLayout>

</layout>
