<?xml version="1.0" encoding="utf-8"?><!--
  ~ Image grid cell reusing the exact SMB large cover card design
  ~ (card_browser_item_large): the same 10dp-margin rounded card
  ~ (20dp radius, big shadow, no border) with the file name below, centered.
  ~ An extra overlay marks the card in multi-selection mode.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/background_default">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <!-- Full bleed 2:3 cover, clipped by the card rounded corners -->
            <ImageView
                    android:id="@+id/image_thumbnail"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintDimensionRatio="H,2:3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            <!-- Multi-selection state: dark scrim over the cover + check mark -->
            <View
                    android:id="@+id/selection_scrim"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="#40000000"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/image_thumbnail"
                    app:layout_constraintEnd_toEndOf="@+id/image_thumbnail"
                    app:layout_constraintStart_toStartOf="@+id/image_thumbnail"
                    app:layout_constraintTop_toTopOf="@+id/image_thumbnail" />

            <ImageView
                    android:id="@+id/selection_check"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/image_check_circle"
                    android:padding="5dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/white"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="@+id/image_thumbnail"
                    app:layout_constraintTop_toTopOf="@+id/image_thumbnail" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
            android:id="@+id/image_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:lines="1"
            android:textColor="?attr/list_title"
            android:textSize="13sp" />

</LinearLayout>
